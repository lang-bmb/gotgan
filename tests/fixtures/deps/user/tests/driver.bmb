#[summary("Test driver of user: writes four times the number of bytes of standard input")]
mod driver {
    #[effects(alloc, io, nondet)]
    fn main() -> () {
        let mut input: Vec<u8> = Vec::new();
        match std::io::read_to_end(&mut input) {
            Ok(n) => {},
            Err(e) => { std::process::exit(2); },
        }
        if input.len() > 1000000 {
            std::process::exit(2);
        }
        print_u64(user::quad(input.len() as u64));
    }
}

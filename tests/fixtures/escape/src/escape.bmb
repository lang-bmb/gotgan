#[summary("A function that proves without the assume it carries: its verify row is plain proved, so only the escape count of bmb query status shows it")]
mod escape {
    spec fn positive(x: u64) -> bool {
        x > 0
    }

    #[summary("x itself")]
    #[effects(panic)]
    fn same(x: u64) -> (r: u64)
        requires x > 0,
        ensures r > 0,
    {
        #[rationale(kind = boundary, "not needed: the precondition says it")]
        assume(positive(x));
        x
    }
}

#[summary("The package declaration (package.json): what a valid declaration is, as the invariant of the type Package, and reading one from its JSON text. A declaration names the package, its version and summary, its units (src/<unit>.bmb each), the standard library units it uses, its executables and its test suites")]
mod decl {
    #[summary("A valid package declaration (the invariant valid). The executables are bin_names, each with the position in units of its entry unit, the unit that holds its fn main, in bin_entries. The packages it depends on are dep_names, each with the path of its directory, relative to this package's directory, in dep_paths")]
    #[invariant(valid)]
    struct Package { name: String, version: String, summary: String, units: Vec<String>, std: Vec<String>, dep_names: Vec<String>, dep_paths: Vec<String>, bin_names: Vec<String>, bin_entries: Vec<usize>, tests: Vec<Suite> }

    #[summary("A test suite: the test units (tests/<unit>.bmb each) built together with the package's units into one driver, the case files it runs (tests/<file> each) and the format of those files")]
    #[invariant(suite_sound)]
    struct Suite { units: Vec<String>, cases: Vec<String>, format: String }

    spec fn absent(v: &[String], s: &str) -> bool {
        forall|k: usize| k < v.len() ==> #[trigger] v[k] != s
    }

    spec fn apart(a: &[String], b: &[String]) -> bool {
        forall|i: usize, j: usize| i < a.len() && j < b.len() ==> #[trigger] a[i] != #[trigger] b[j]
    }

    #[summary("The first of v that is not a file name, none when all are")]
    #[effects(pure)]
    #[uses(files)]
    fn bad_file(v: &[String]) -> (r: Option<usize>)
        ensures first_bad_file(r, v),
    {
        for k in 0..v.len()
            invariant forall|m: usize| m < k ==> #[trigger] file_name(v[m].as_str()),
        {
            if !is_file(v[k].as_str()) {
                return Some(k);
            }
        }
        None
    }

    #[summary("The first of v that cannot name a unit, none when all can")]
    #[effects(pure)]
    #[uses(idents)]
    fn bad_ident(v: &[String]) -> (r: Option<usize>)
        ensures first_bad_ident(r, v),
    {
        for k in 0..v.len()
            invariant forall|m: usize| m < k ==> #[trigger] unit_name(v[m].as_str()),
        {
            if !is_unit_name(v[k].as_str()) {
                return Some(k);
            }
        }
        None
    }

    #[summary("The first of v that is not a unit of the standard library, none when all are")]
    #[effects(pure)]
    #[uses(std_units)]
    fn bad_std(v: &[String]) -> (r: Option<usize>)
        ensures first_bad_std(r, v),
    {
        for k in 0..v.len()
            invariant forall|m: usize| m < k ==> #[trigger] std_unit(v[m].as_str()),
        {
            if !is_std(v[k].as_str()) {
                return Some(k);
            }
        }
        None
    }

    #[summary("The executables: at most one (a package is one program, with one fn main), with a name and its entry unit among n units")]
    spec fn bins_part(names: &[String], entries: &[usize], n: usize) -> bool {
        names.len() <= 1 && names.len() == entries.len() && names_ok(names) && distinct(names) && entries_ok(entries, n)
    }

    #[summary("The dependencies that the deps object node dn declares: the standard library units of its member std into out, and the packages of its member packages into names and paths (all cleared first). deps has no other member")]
    #[effects(alloc)]
    #[uses(deps_read, std::json::doc_sound, std::json::nodes_in, std::json::some_node)]
    fn deps(d: &std::json::Doc, t: &[u8], node: Option<usize>, out: &mut Vec<String>, names: &mut Vec<String>, paths: &mut Vec<String>) -> (r: Result<(), String>)
        requires std::json::some_node(d, node), same_text(d, t),
        ensures deps_read(&r, out.as_slice(), names.as_slice(), paths.as_slice()),
    {
        let dn: usize = match node {
            None => { std_list(d, t, None, out)?; packages(d, t, None, names, paths)?; return Ok(()); },
            Some(x) => x,
        };
        let mut ks: Vec<String> = Vec::new();
        keys(d, t, dn, "package.json: `deps`", &mut ks)?;
        for k in 0..ks.len()
            invariant k <= ks.len(),
        {
            if ks[k] != "std" && ks[k] != "packages" {
                return Err(text::cat3("package.json: `deps` has the member `", ks[k].as_str(), "` (the members are std, the units of the standard library, and packages, the packages depended on by path)"));
            }
        }
        std_list(d, t, d.member(t, dn, "std"), out)?;
        packages(d, t, d.member(t, dn, "packages"), names, paths)?;
        Ok(())
    }

    spec fn deps_read(r: &Result<(), String>, out: &[String], names: &[String], paths: &[String]) -> bool {
        match r {
            Ok(u) => std_part(out) && packages_part(names, paths),
            Err(e) => true,
        }
    }

    spec fn digit(b: u8) -> bool {
        48 <= b && b <= 57
    }

    spec fn distinct(v: &[String]) -> bool {
        forall|i: usize, j: usize| i < j && j < v.len() ==> #[trigger] v[i] != #[trigger] v[j]
    }

    spec fn entries_ok(e: &[usize], n: usize) -> bool {
        (forall|k: usize| k < e.len() ==> #[trigger] e[k] < n) && (forall|i: usize, j: usize| i < j && j < e.len() ==> #[trigger] e[i] != #[trigger] e[j])
    }

    #[summary("The executables that the bin object node bn declares, their names into out and the positions in units of their entry units into entries (both cleared first): each member is the name of an executable and its value the name of its entry unit, one of units, and no two executables share an entry unit")]
    #[effects(alloc)]
    #[uses(bins_part, placed, std::json::doc_sound, std::json::nodes_in, std::json::some_node)]
    fn executables(d: &std::json::Doc, t: &[u8], node: Option<usize>, units: &[String], out: &mut Vec<String>, entries: &mut Vec<usize>) -> (r: Result<(), String>)
        requires std::json::some_node(d, node), same_text(d, t),
        ensures bins_part(out.as_slice(), entries.as_slice(), units.len()),
    {
        *out = Vec::new();
        *entries = Vec::new();
        let bn: usize = match node {
            None => { return Ok(()); },
            Some(b) => b,
        };
        let mut names: Vec<String> = Vec::new();
        keys(d, t, bn, "package.json: `bin`", &mut names)?;
        if names.len() > 1 {
            return Err(String::from("package.json: `bin` declares more than one executable: the units of a package are built as one program, and a program has one fn main"));
        }
        for k in 0..names.len()
            invariant k <= names.len(), names.len() <= 1, out.len() <= k, out.len() == entries.len(), names_ok(out.as_slice()), distinct(out.as_slice()), entries_ok(entries.as_slice(), units.len()),
        {
            if !is_ident(names[k].as_str()) {
                return Err(text::cat3("package.json: the executable `", names[k].as_str(), "` is not a name (1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter)"));
            }
            let unit: String = match d.member(t, bn, names[k].as_str()) {
                None => { return Err(text::cat3("package.json: `bin.", names[k].as_str(), "` is missing")); },
                Some(v) => match d.string_value(t, v) { None => { return Err(text::cat3("package.json: `bin.", names[k].as_str(), "` is not text (the name of its entry unit)")); }, Some(u) => u, },
            };
            let unit_index: usize = match position(units, unit.as_str()) {
                None => { return Err(text::cat5("package.json: the entry unit `", unit.as_str(), "` of the executable `", names[k].as_str(), "` is not one of `units`")); },
                Some(e) => e,
            };
            if taken(entries.as_slice(), unit_index) {
                return Err(text::cat3("package.json: two executables have the entry unit `", unit.as_str(), "`"));
            }
            match position(out.as_slice(), names[k].as_str()) {
                None => {},
                Some(at) => { return Err(text::cat3("package.json: the executable `", names[k].as_str(), "` comes twice")); },
            }
            push_name(out, names[k].clone());
            push_entry(entries, unit_index, units.len());
        }
        Ok(())
    }

    spec fn file_byte(b: u8) -> bool {
        97 <= b && b <= 122 || 65 <= b && b <= 90 || 48 <= b && b <= 57 || b == 95 || b == 45 || b == 46
    }

    #[summary("A file name of tests/: 1 to 64 bytes of ASCII letters, digits, _, - and ., the first not a dot")]
    spec fn file_name(s: &str) -> bool {
        0 < s.len() && s.len() <= 64 && s.as_bytes()[0] != 46 && (forall|k: usize| k < s.len() ==> file_byte(#[trigger] s.as_bytes()[k]))
    }

    spec fn files(v: &[String]) -> bool {
        forall|k: usize| k < v.len() ==> #[trigger] file_name(v[k].as_str())
    }

    spec fn first_bad_file(r: Option<usize>, v: &[String]) -> bool {
        match r {
            None => files(v),
            Some(k) => k < v.len() && !file_name(v[k].as_str()),
        }
    }

    spec fn first_bad_ident(r: Option<usize>, v: &[String]) -> bool {
        match r {
            None => idents(v),
            Some(k) => k < v.len() && !unit_name(v[k].as_str()),
        }
    }

    spec fn first_bad_std(r: Option<usize>, v: &[String]) -> bool {
        match r {
            None => std_units(v),
            Some(k) => k < v.len() && !std_unit(v[k].as_str()),
        }
    }

    spec fn first_shared(r: Option<usize>, a: &[String], b: &[String]) -> bool {
        match r {
            None => apart(a, b),
            Some(i) => i < a.len() && !absent(b, a[i].as_str()),
        }
    }

    spec fn first_unnamed(r: Option<usize>, v: &[String], p: &str) -> bool {
        match r {
            None => named_units(v, p),
            Some(k) => k < v.len() && !named_after(v[k].as_str(), p),
        }
    }

    spec fn free(e: &[usize], x: usize) -> bool {
        forall|k: usize| k < e.len() ==> #[trigger] e[k] != x
    }

    #[summary("A name of a package or an executable: 1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter")]
    spec fn ident(s: &str) -> bool {
        0 < s.len() && s.len() <= 64 && 97 <= s.as_bytes()[0] && s.as_bytes()[0] <= 122 && (forall|k: usize| k < s.len() ==> ident_byte(#[trigger] s.as_bytes()[k]))
    }

    spec fn ident_byte(b: u8) -> bool {
        97 <= b && b <= 122 || 48 <= b && b <= 57 || b == 95
    }

    spec fn idents(v: &[String]) -> bool {
        forall|k: usize| k < v.len() ==> #[trigger] unit_name(v[k].as_str())
    }

    #[summary("Whether s is the name of a file of tests/: 1 to 64 bytes of ASCII letters, digits, _, - and ., the first not a dot")]
    #[effects(pure)]
    #[uses(file_byte, file_name)]
    fn is_file(s: &str) -> (r: bool)
        ensures r == file_name(s),
    {
        let n: usize = s.len();
        if n == 0 || n > 64 || s.as_bytes()[0] == 46 {
            return false;
        }
        for k in 0..n
            invariant forall|m: usize| m < k ==> file_byte(#[trigger] s.as_bytes()[m]),
        {
            let c: u8 = s.as_bytes()[k];
            if !(97 <= c && c <= 122 || 65 <= c && c <= 90 || 48 <= c && c <= 57 || c == 95 || c == 45 || c == 46) {
                return false;
            }
        }
        true
    }

    #[summary("Whether s is a name of a package or an executable: 1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter")]
    #[effects(pure)]
    #[uses(ident, ident_byte)]
    fn is_ident(s: &str) -> (r: bool)
        ensures r == ident(s),
    {
        let n: usize = s.len();
        if n == 0 || n > 64 || s.as_bytes()[0] < 97 || s.as_bytes()[0] > 122 {
            return false;
        }
        for k in 0..n
            invariant forall|m: usize| m < k ==> ident_byte(#[trigger] s.as_bytes()[m]),
        {
            let c: u8 = s.as_bytes()[k];
            if !(97 <= c && c <= 122 || 48 <= c && c <= 57 || c == 95) {
                return false;
            }
        }
        true
    }

    #[summary("Whether the unit s is named after the package p: s is p, or p followed by _ and more")]
    #[effects(pure)]
    #[uses(named_after)]
    fn is_named_after(s: &str, p: &str) -> (r: bool)
        ensures r == named_after(s, p),
    {
        if s == p {
            return true;
        }
        if s.len() <= p.len() || s.as_bytes()[p.len()] != 95 {
            return false;
        }
        for k in 0..p.len()
            invariant k <= p.len(), p.len() < s.len(), forall|m: usize| m < k ==> #[trigger] s.as_bytes()[m] == p.as_bytes()[m],
        {
            if s.as_bytes()[k] != p.as_bytes()[k] {
                return false;
            }
        }
        true
    }

    #[summary("Whether s names a unit of the standard library that the compiler carries")]
    #[effects(pure)]
    #[uses(std_unit)]
    fn is_std(s: &str) -> (r: bool)
        ensures r == std_unit(s),
    {
        s == "base64" || s == "bytes" || s == "collections" || s == "crc32" || s == "intern" || s == "json" || s == "num" || s == "sha256" || s == "slice" || s == "str" || s == "utf8"
    }

    #[summary("Whether s can name a unit: a name that is not a reserved word of the language or std")]
    #[effects(pure)]
    #[uses(reserved, unit_name)]
    fn is_unit_name(s: &str) -> (r: bool)
        ensures r == unit_name(s),
    {
        is_ident(s) && !(s == "fn" || s == "spec" || s == "proof" || s == "mod" || s == "let" || s == "mut" || s == "while" || s == "if" || s == "else" || s == "true" || s == "false" || s == "requires" || s == "ensures" || s == "decreases" || s == "invariant" || s == "forall" || s == "exists" || s == "old" || s == "assert" || s == "assume" || s == "return" || s == "for" || s == "loop" || s == "match" || s == "break" || s == "continue" || s == "as" || s == "pub" || s == "struct" || s == "enum" || s == "impl" || s == "trait" || s == "use" || s == "const" || s == "static" || s == "type" || s == "unsafe" || s == "self" || s == "crate" || s == "super" || s == "where" || s == "ref" || s == "move" || s == "dyn" || s == "in" || s == "async" || s == "await" || s == "std")
    }

    #[summary("Whether s is a version MAJOR.MINOR.PATCH: three non-empty runs of decimal digits joined by two dots")]
    #[effects(pure)]
    #[uses(digit, version)]
    fn is_version(s: &str) -> (r: bool)
        ensures r == version(s),
    {
        let n: usize = s.len();
        let mut i: usize = 0;
        let mut j: usize = 0;
        let mut dots: usize = 0;
        for k in 0..n
            invariant dots <= 2, dots >= 1 ==> i < k && s.as_bytes()[i] == 46, dots == 2 ==> i < j && j < k && s.as_bytes()[j] == 46, forall|m: usize| m < k ==> dots >= 1 && m == i || dots == 2 && m == j || digit(#[trigger] s.as_bytes()[m]),
        {
            let c: u8 = s.as_bytes()[k];
            if c == 46 {
                if dots == 0 {
                    i = k;
                    dots = 1;
                } else if dots == 1 {
                    j = k;
                    dots = 2;
                } else {
                    return false;
                }
            } else if c < 48 || c > 57 {
                return false;
            }
        }
        dots == 2 && 0 < i && i + 1 < j && j + 1 < n
    }

    #[summary("The member names of object node o of the JSON text t, in order, into out (cleared first). An error, naming the object as what, when o is not an object, when a name is written with an escape, or when a name comes twice")]
    #[effects(alloc)]
    #[uses(placed, std::json::after, std::json::doc_sound, std::json::node_count, std::json::nodes_in)]
    fn keys(d: &std::json::Doc, t: &[u8], o: usize, what: &str, out: &mut Vec<String>) -> (r: Result<(), String>)
        requires std::json::node_pos(d, o), same_text(d, t),
        ensures distinct(out.as_slice()),
    {
        *out = Vec::new();
        if d.kind(o) != 6 {
            return Err(text::cat2(what, " is not a JSON object"));
        }
        let end: usize = d.next(o);
        let mut c: usize = o + 1;
        while c + 1 < end
            invariant o < c, c <= d.nodes.len(), end <= d.nodes.len(), distinct(out.as_slice()),
            decreases end - c,
        {
            let k: String = match d.string_value(t, c) {
                None => { return Err(text::cat2(what, ": a member name is not text")); },
                Some(k) => k,
            };
            if !d.raw_is(t, c, k.as_str()) {
                return Err(text::cat4(what, ": the member name ", k.as_str(), " is written with an escape"));
            }
            match position(out.as_slice(), k.as_str()) {
                None => {},
                Some(at) => { return Err(text::cat4(what, ": the member `", k.as_str(), "` comes twice")); },
            }
            push_new(out, k);
            c = d.next(c + 1);
        }
        Ok(())
    }

    #[summary("Checks the distinct units of the package name with nbins executables: at least one, each able to name a unit, and, for a library (no executable), each named after the package. The error says which unit breaks which rule")]
    #[effects(alloc)]
    #[uses(first_bad_ident, first_unnamed, units_part)]
    fn library_units(name: &str, units: &[String], nbins: usize) -> (r: Result<(), String>)
        requires distinct(units),
        ensures units_checked(&r, name, units, nbins),
    {
        if units.len() == 0 {
            return Err(String::from("package.json: `units` is empty (a package has at least one unit)"));
        }
        match bad_ident(units) {
            None => {},
            Some(k) => { return Err(text::cat3("package.json: the unit `", units[k].as_str(), "` cannot name a unit (1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter, and not a reserved word or std)")); },
        }
        if nbins == 0 {
            match unnamed(units, name) {
                None => {},
                Some(k) => { return Err(text::cat5("package.json: the unit `", units[k].as_str(), "` of the library `", name, text::cat5("` is not named after it: a unit of a package without executables (bin) must be named `", name, "` or start with `", name, "_`").as_str())); },
            }
        }
        Ok(())
    }

    #[summary("The declaration made of its parts, which meet the invariant valid clause by clause")]
    #[effects(alloc)]
    #[uses(valid)]
    fn make(name: String, version: String, summary: String, units: Vec<String>, std: Vec<String>, dep_names: Vec<String>, dep_paths: Vec<String>, bin_names: Vec<String>, bin_entries: Vec<usize>, tests: Vec<Suite>) -> Package
        requires ident(name.as_str()), version(version.as_str()), units_part(name.as_str(), units.as_slice(), bin_names.len()), std_part(std.as_slice()), packages_part(dep_names.as_slice(), dep_paths.as_slice()), absent(dep_names.as_slice(), name.as_str()), bins_part(bin_names.as_slice(), bin_entries.as_slice(), units.len()), suites_apart(tests.as_slice(), units.as_slice()),
    {
        Package { name: name, version: version, summary: summary, units: units, std: std, dep_names: dep_names, dep_paths: dep_paths, bin_names: bin_names, bin_entries: bin_entries, tests: tests }
    }

    #[summary("The naming rule of a library: the unit s is the package name p, or starts with p followed by _")]
    spec fn named_after(s: &str, p: &str) -> bool {
        s == p || p.len() < s.len() && s.as_bytes()[p.len()] == 95 && (forall|k: usize| k < p.len() ==> #[trigger] s.as_bytes()[k] == p.as_bytes()[k])
    }

    #[summary("Every unit of v is named after the package p")]
    spec fn named_units(v: &[String], p: &str) -> bool {
        forall|k: usize| k < v.len() ==> #[trigger] named_after(v[k].as_str(), p)
    }

    spec fn names_ok(v: &[String]) -> bool {
        forall|k: usize| k < v.len() ==> #[trigger] ident(v[k].as_str())
    }

    #[summary("The text of member key of object node o; an error when it is missing or not text")]
    #[effects(alloc)]
    #[uses(std::json::doc_sound, std::json::nodes_in, std::json::some_node)]
    fn need_text(d: &std::json::Doc, t: &[u8], o: usize, key: &str) -> Result<String, String>
        requires std::json::node_pos(d, o), same_text(d, t),
    {
        match d.member(t, o, key) {
            None => Err(text::cat3("package.json: the member `", key, "` is missing")),
            Some(n) => match d.string_value(t, n) { None => Err(text::cat3("package.json: `", key, "` is not text")), Some(v) => Ok(v), },
        }
    }

    #[summary("The packages that the deps.packages object node pn names, into names and paths (both cleared first): each member is the name of a package and its value an object with the one member path, the non-empty path of that package's directory relative to this one")]
    #[effects(alloc)]
    #[uses(packages_part, placed, std::json::doc_sound, std::json::nodes_in, std::json::some_node)]
    fn packages(d: &std::json::Doc, t: &[u8], node: Option<usize>, names: &mut Vec<String>, paths: &mut Vec<String>) -> (r: Result<(), String>)
        requires std::json::some_node(d, node), same_text(d, t),
        ensures packages_part(names.as_slice(), paths.as_slice()),
    {
        *names = Vec::new();
        *paths = Vec::new();
        let pn: usize = match node {
            None => { return Ok(()); },
            Some(x) => x,
        };
        let mut ks: Vec<String> = Vec::new();
        keys(d, t, pn, "package.json: `deps.packages`", &mut ks)?;
        for k in 0..ks.len()
            invariant k <= ks.len(), names.len() == paths.len(), names_ok(names.as_slice()), distinct(names.as_slice()), paths_ok(paths.as_slice()),
        {
            if !is_ident(ks[k].as_str()) {
                return Err(text::cat3("package.json: `deps.packages` names `", ks[k].as_str(), "`, which is not a package name (1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter)"));
            }
            let what: String = text::cat3("package.json: `deps.packages.", ks[k].as_str(), "`");
            let v: usize = match d.member(t, pn, ks[k].as_str()) {
                None => { return Err(text::cat2(what.as_str(), " is missing")); },
                Some(v) => v,
            };
            let mut inner: Vec<String> = Vec::new();
            keys(d, t, v, what.as_str(), &mut inner)?;
            for m in 0..inner.len()
                invariant m <= inner.len(),
            {
                if inner[m] != "path" {
                    return Err(text::cat4(what.as_str(), " has the member `", inner[m].as_str(), "` (the one member is path: no versions and no fetching yet)"));
                }
            }
            let path: String = match d.member(t, v, "path") {
                None => { return Err(text::cat2(what.as_str(), " has no `path`")); },
                Some(pv) => match d.string_value(t, pv) { None => { return Err(text::cat2(what.as_str(), ": `path` is not text")); }, Some(pt) => pt, },
            };
            if path.len() == 0 {
                return Err(text::cat2(what.as_str(), ": `path` is empty"));
            }
            match position(names.as_slice(), ks[k].as_str()) {
                None => {},
                Some(at) => { return Err(text::cat2(what.as_str(), " comes twice")); },
            }
            push_dep(names, paths, ks[k].clone(), path);
        }
        Ok(())
    }

    #[summary("The packages depended on: distinct names, each with a non-empty path")]
    spec fn packages_part(names: &[String], paths: &[String]) -> bool {
        names.len() == paths.len() && names_ok(names) && distinct(names) && paths_ok(paths)
    }

    #[summary("Reads a declaration from the text t of package.json: a JSON object with the members name, version, summary and units, and optionally licence, deps, origin, bin and tests. Any other member, a member of the wrong kind, or a value that breaks the invariant of Package is an error that says which")]
    #[effects(alloc)]
    #[uses(deps_read, placed, same_text, std::json::doc_sound, std::json::nodes_in, std::json::parsed, std::json::some_node, units_checked)]
    fn parse(t: &[u8]) -> Result<Package, String> {
        if t.len() > 16777216 {
            return Err(String::from("package.json: longer than 16 MiB"));
        }
        let d: std::json::Doc = match std::json::parse(t) {
            None => { return Err(String::from("package.json: not a JSON text")); },
            Some(d) => d,
        };
        let mut top: Vec<String> = Vec::new();
        keys(&d, t, 0, "package.json", &mut top)?;
        for k in 0..top.len()
            invariant k <= top.len(),
        {
            if !top_key(top[k].as_str()) {
                return Err(text::cat3("package.json: unknown member `", top[k].as_str(), "` (the members are name, version, summary, licence, units, deps, origin, bin and tests)"));
            }
        }
        let name: String = need_text(&d, t, 0, "name")?;
        if !is_ident(name.as_str()) {
            return Err(text::cat3("package.json: the name `", name.as_str(), "` is not a name (1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter)"));
        }
        let version: String = need_text(&d, t, 0, "version")?;
        if !is_version(version.as_str()) {
            return Err(text::cat3("package.json: the version `", version.as_str(), "` is not MAJOR.MINOR.PATCH"));
        }
        let summary: String = need_text(&d, t, 0, "summary")?;
        match d.member(t, 0, "licence") {
            None => {},
            Some(l) => { if d.kind(l) != 4 { return Err(String::from("package.json: `licence` is not text")); } },
        }
        match d.member(t, 0, "origin") {
            None => {},
            Some(o) => { if d.kind(o) != 6 { return Err(String::from("package.json: `origin` is not a JSON object")); } },
        }
        let mut units: Vec<String> = Vec::new();
        match d.member(t, 0, "units") {
            None => { return Err(String::from("package.json: the member `units` is missing")); },
            Some(u) => strings(&d, t, u, "package.json: `units`", &mut units)?,
        }
        let mut std: Vec<String> = Vec::new();
        let mut dep_names: Vec<String> = Vec::new();
        let mut dep_paths: Vec<String> = Vec::new();
        deps(&d, t, d.member(t, 0, "deps"), &mut std, &mut dep_names, &mut dep_paths)?;
        match position(dep_names.as_slice(), name.as_str()) {
            None => {},
            Some(at) => { return Err(text::cat3("package.json: the package `", name.as_str(), "` depends on itself")); },
        }
        let mut bin_names: Vec<String> = Vec::new();
        let mut bin_entries: Vec<usize> = Vec::new();
        executables(&d, t, d.member(t, 0, "bin"), units.as_slice(), &mut bin_names, &mut bin_entries)?;
        library_units(name.as_str(), units.as_slice(), bin_names.len())?;
        let mut tests: Vec<Suite> = Vec::new();
        match d.member(t, 0, "tests") {
            None => {},
            Some(tn) => suites(&d, t, tn, units.as_slice(), &mut tests)?,
        }
        Ok(make(name, version, summary, units, std, dep_names, dep_paths, bin_names, bin_entries, tests))
    }

    #[summary("Every path of v is non-empty")]
    spec fn paths_ok(v: &[String]) -> bool {
        forall|k: usize| k < v.len() ==> 0 < #[trigger] v[k].len()
    }

    spec fn placed(r: Option<usize>, v: &[String], s: &str) -> bool {
        match r {
            None => absent(v, s),
            Some(k) => k < v.len() && v[k] == s,
        }
    }

    #[summary("Where s is in v first, none when it is not there")]
    #[effects(pure)]
    #[uses(absent)]
    fn position(v: &[String], s: &str) -> (r: Option<usize>)
        ensures placed(r, v, s),
    {
        for k in 0..v.len()
            invariant forall|m: usize| m < k ==> #[trigger] v[m] != s,
        {
            if v[k] == s {
                return Some(k);
            }
        }
        None
    }

    #[summary("Adds the dependency name with the path, a name v does not hold, to the distinct names v and their paths w")]
    #[effects(alloc)]
    #[uses(absent, distinct, names_ok, paths_ok)]
    fn push_dep(v: &mut Vec<String>, w: &mut Vec<String>, name: String, path: String) -> ()
        requires names_ok(v.as_slice()), distinct(v.as_slice()), absent(v.as_slice(), name.as_str()), ident(name.as_str()), paths_ok(w.as_slice()), 0 < path.len(), v.len() == w.len(),
        ensures names_ok(v.as_slice()), distinct(v.as_slice()), paths_ok(w.as_slice()), v.len() == w.len(),
    {
        v.push(name);
        w.push(path);
    }

    #[summary("Adds the position x of an entry unit among n units, which e does not hold, to the distinct positions e")]
    #[effects(alloc)]
    #[uses(entries_ok, free)]
    fn push_entry(e: &mut Vec<usize>, x: usize, n: usize) -> ()
        requires entries_ok(e.as_slice(), n), free(e.as_slice(), x), x < n,
        ensures entries_ok(e.as_slice(), n), e.len() == old(e).len() + 1,
    {
        e.push(x);
    }

    #[summary("Adds the name s of an executable, which v does not hold, to the distinct names v")]
    #[effects(alloc)]
    #[uses(absent, distinct, names_ok)]
    fn push_name(v: &mut Vec<String>, s: String) -> ()
        requires names_ok(v.as_slice()), distinct(v.as_slice()), absent(v.as_slice(), s.as_str()), ident(s.as_str()),
        ensures names_ok(v.as_slice()), distinct(v.as_slice()), v.len() == old(v).len() + 1,
    {
        v.push(s);
    }

    #[summary("Adds s, which v does not hold, to the distinct texts v")]
    #[effects(alloc)]
    #[uses(absent, distinct)]
    fn push_new(v: &mut Vec<String>, s: String) -> ()
        requires distinct(v.as_slice()), absent(v.as_slice(), s.as_str()),
        ensures distinct(v.as_slice()),
    {
        v.push(s);
    }

    #[summary("Adds the test suite s, whose units are not units of the package, to v")]
    #[effects(alloc)]
    #[uses(suites_apart)]
    fn push_suite(v: &mut Vec<Suite>, s: Suite, units: &[String]) -> ()
        requires suites_apart(v.as_slice(), units), apart(s.units.as_slice(), units),
        ensures suites_apart(v.as_slice(), units),
    {
        v.push(s);
    }

    #[summary("A reserved word of the language, or std (the top-level unit of the standard library): neither can name a unit")]
    spec fn reserved(s: &str) -> bool {
        s == "fn" || s == "spec" || s == "proof" || s == "mod" || s == "let" || s == "mut" || s == "while" || s == "if" || s == "else" || s == "true" || s == "false" || s == "requires" || s == "ensures" || s == "decreases" || s == "invariant" || s == "forall" || s == "exists" || s == "old" || s == "assert" || s == "assume" || s == "return" || s == "for" || s == "loop" || s == "match" || s == "break" || s == "continue" || s == "as" || s == "pub" || s == "struct" || s == "enum" || s == "impl" || s == "trait" || s == "use" || s == "const" || s == "static" || s == "type" || s == "unsafe" || s == "self" || s == "crate" || s == "super" || s == "where" || s == "ref" || s == "move" || s == "dyn" || s == "in" || s == "async" || s == "await" || s == "std"
    }

    spec fn same_text(d: &std::json::Doc, t: &[u8]) -> bool {
        d.len == t.len()
    }

    #[summary("The first of a that is also in b, none when they share none")]
    #[effects(pure)]
    #[uses(absent, apart)]
    fn shared(a: &[String], b: &[String]) -> (r: Option<usize>)
        ensures first_shared(r, a, b),
    {
        for i in 0..a.len()
            invariant forall|m: usize, j: usize| m < i && j < b.len() ==> #[trigger] a[m] != #[trigger] b[j],
        {
            match position(b, a[i].as_str()) {
                None => {},
                Some(j) => { return Some(i); },
            }
        }
        None
    }

    #[summary("The standard library units of the deps.std array node, into out (cleared first; empty when there is no node): distinct units of the standard library")]
    #[effects(alloc)]
    #[uses(first_bad_std, std::json::doc_sound, std::json::nodes_in, std::json::some_node, std_part, std_units)]
    fn std_list(d: &std::json::Doc, t: &[u8], node: Option<usize>, out: &mut Vec<String>) -> (r: Result<(), String>)
        requires std::json::some_node(d, node), same_text(d, t),
        ensures std_part(out.as_slice()),
    {
        *out = Vec::new();
        let sn: usize = match node {
            None => { return Ok(()); },
            Some(x) => x,
        };
        let mut found: Vec<String> = Vec::new();
        strings(d, t, sn, "package.json: `deps.std`", &mut found)?;
        match bad_std(found.as_slice()) {
            None => {},
            Some(b) => { return Err(text::cat3("package.json: `deps.std` names `", found[b].as_str(), "`, which is not a unit of the standard library (base64, bytes, collections, crc32, intern, json, num, sha256, slice, str, utf8)")); },
        }
        *out = found;
        Ok(())
    }

    #[summary("The standard library units of a declaration: distinct units of the standard library")]
    spec fn std_part(v: &[String]) -> bool {
        std_units(v) && distinct(v)
    }

    spec fn std_unit(s: &str) -> bool {
        s == "base64" || s == "bytes" || s == "collections" || s == "crc32" || s == "intern" || s == "json" || s == "num" || s == "sha256" || s == "slice" || s == "str" || s == "utf8"
    }

    spec fn std_units(v: &[String]) -> bool {
        forall|k: usize| k < v.len() ==> #[trigger] std_unit(v[k].as_str())
    }

    #[summary("The texts of array node a of the JSON text t, in order, into out (cleared first). An error, naming the array as what, when a is not an array, an element is not text, or a text comes twice")]
    #[effects(alloc)]
    #[uses(placed, std::json::after, std::json::doc_sound, std::json::node_count, std::json::nodes_in)]
    fn strings(d: &std::json::Doc, t: &[u8], a: usize, what: &str, out: &mut Vec<String>) -> (r: Result<(), String>)
        requires std::json::node_pos(d, a), same_text(d, t),
        ensures distinct(out.as_slice()),
    {
        *out = Vec::new();
        if d.kind(a) != 5 {
            return Err(text::cat2(what, " is not a JSON array"));
        }
        let end: usize = d.next(a);
        let mut c: usize = a + 1;
        while c < end
            invariant a < c, c <= d.nodes.len(), end <= d.nodes.len(), distinct(out.as_slice()),
            decreases end - c,
        {
            let v: String = match d.string_value(t, c) {
                None => { return Err(text::cat2(what, ": an element is not text")); },
                Some(v) => v,
            };
            match position(out.as_slice(), v.as_str()) {
                None => {},
                Some(at) => { return Err(text::cat4(what, ": `", v.as_str(), "` comes twice")); },
            }
            push_new(out, v);
            c = d.next(c);
        }
        Ok(())
    }

    #[summary("Whether k is a member of a test suite")]
    #[effects(pure)]
    fn suite_key(k: &str) -> bool {
        k == "units" || k == "cases" || k == "format"
    }

    #[summary("The invariant of Suite: at least one test unit, each able to name a unit and distinct, at least one case file, each a file name and distinct, and the format args|stdin|stdout")]
    spec fn suite_sound(s: &Suite) -> bool {
        0 < s.units.len() && idents(s.units.as_slice()) && distinct(s.units.as_slice()) && 0 < s.cases.len() && files(s.cases.as_slice()) && distinct(s.cases.as_slice()) && the_format(s.format.as_str())
    }

    #[summary("The test suites that the tests array node tn declares, into out (cleared first): each element is an object with the members units (test units, none of them a unit of the package), cases (files of tests/) and format (args|stdin|stdout)")]
    #[effects(alloc)]
    #[uses(first_bad_file, first_bad_ident, first_shared, std::json::after, std::json::doc_sound, std::json::node_count, std::json::nodes_in, std::json::some_node, suite_sound, the_format)]
    fn suites(d: &std::json::Doc, t: &[u8], tn: usize, units: &[String], out: &mut Vec<Suite>) -> (r: Result<(), String>)
        requires std::json::node_pos(d, tn), same_text(d, t),
        ensures suites_apart(out.as_slice(), units),
    {
        *out = Vec::new();
        if d.kind(tn) != 5 {
            return Err(String::from("package.json: `tests` is not a JSON array"));
        }
        let end: usize = d.next(tn);
        let mut c: usize = tn + 1;
        while c < end
            invariant tn < c, c <= d.nodes.len(), end <= d.nodes.len(), suites_apart(out.as_slice(), units),
            decreases end - c,
        {
            let mut ks: Vec<String> = Vec::new();
            keys(d, t, c, "package.json: a test suite", &mut ks)?;
            for k in 0..ks.len()
                invariant k <= ks.len(),
            {
                if !suite_key(ks[k].as_str()) {
                    return Err(text::cat3("package.json: a test suite has the member `", ks[k].as_str(), "` (the members are units, cases and format)"));
                }
            }
            let mut tu: Vec<String> = Vec::new();
            match d.member(t, c, "units") {
                None => { return Err(String::from("package.json: a test suite has no `units`")); },
                Some(u) => strings(d, t, u, "package.json: the `units` of a test suite", &mut tu)?,
            }
            if tu.len() == 0 {
                return Err(String::from("package.json: the `units` of a test suite is empty"));
            }
            match bad_ident(tu.as_slice()) {
                None => {},
                Some(b) => { return Err(text::cat3("package.json: the test unit `", tu[b].as_str(), "` cannot name a unit (1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter, and not a reserved word or std)")); },
            }
            match shared(tu.as_slice(), units) {
                None => {},
                Some(b2) => { return Err(text::cat3("package.json: the test unit `", tu[b2].as_str(), "` has the name of a unit of the package")); },
            }
            let mut cases: Vec<String> = Vec::new();
            match d.member(t, c, "cases") {
                None => { return Err(String::from("package.json: a test suite has no `cases`")); },
                Some(cn) => strings(d, t, cn, "package.json: the `cases` of a test suite", &mut cases)?,
            }
            if cases.len() == 0 {
                return Err(String::from("package.json: the `cases` of a test suite is empty"));
            }
            match bad_file(cases.as_slice()) {
                None => {},
                Some(b3) => { return Err(text::cat3("package.json: the case file `", cases[b3].as_str(), "` is not the name of a file of tests/ (1 to 64 bytes of ASCII letters, digits, _, - and ., the first not a dot)")); },
            }
            let format: String = match d.member(t, c, "format") {
                None => { return Err(String::from("package.json: a test suite has no `format`")); },
                Some(fnode) => match d.string_value(t, fnode) { None => { return Err(String::from("package.json: the `format` of a test suite is not text")); }, Some(f) => f, },
            };
            if format != "args|stdin|stdout" {
                return Err(text::cat3("package.json: the test format `", format.as_str(), "` is not known (the format is args|stdin|stdout)"));
            }
            push_suite(out, Suite { units: tu, cases: cases, format: format }, units);
            c = d.next(c);
        }
        Ok(())
    }

    spec fn suites_apart(s: &[Suite], units: &[String]) -> bool {
        forall|k: usize| k < s.len() ==> #[trigger] apart(s[k].units.as_slice(), units)
    }

    #[summary("Whether the entry unit x is already in e")]
    #[effects(pure)]
    #[uses(free)]
    fn taken(e: &[usize], x: usize) -> (r: bool)
        ensures !r ==> free(e, x),
    {
        for k in 0..e.len()
            invariant forall|m: usize| m < k ==> #[trigger] e[m] != x,
        {
            if e[k] == x {
                return true;
            }
        }
        false
    }

    spec fn the_format(s: &str) -> bool {
        s == "args|stdin|stdout"
    }

    #[summary("Whether k is a member of the top level of package.json")]
    #[effects(pure)]
    fn top_key(k: &str) -> bool {
        k == "name" || k == "version" || k == "summary" || k == "licence" || k == "units" || k == "deps" || k == "origin" || k == "bin" || k == "tests"
    }

    #[summary("A name that can name a unit: a name that is not reserved")]
    spec fn unit_name(s: &str) -> bool {
        ident(s) && !reserved(s)
    }

    spec fn units_checked(r: &Result<(), String>, name: &str, units: &[String], nbins: usize) -> bool {
        match r {
            Ok(u) => units_part(name, units, nbins),
            Err(e) => true,
        }
    }

    #[summary("The units of a package named name with nbins executables: at least one, each able to name a unit, distinct, and when there is no executable each named after the package")]
    spec fn units_part(name: &str, units: &[String], nbins: usize) -> bool {
        0 < units.len() && idents(units) && distinct(units) && (nbins > 0 || named_units(units, name))
    }

    #[summary("The first unit of v that is not named after the package p, none when all are")]
    #[effects(pure)]
    #[uses(named_units)]
    fn unnamed(v: &[String], p: &str) -> (r: Option<usize>)
        ensures first_unnamed(r, v, p),
    {
        for k in 0..v.len()
            invariant forall|m: usize| m < k ==> #[trigger] named_after(v[m].as_str(), p),
        {
            if !is_named_after(v[k].as_str(), p) {
                return Some(k);
            }
        }
        None
    }

    #[summary("The invariant of Package: the name is a name and the units can name units, there is at least one unit and they are distinct, the version is MAJOR.MINOR.PATCH, the standard library units are distinct units of the standard library, the packages depended on have distinct names, none of them this package, and non-empty paths, every executable has a distinct name and its own entry unit among the units, a package without executables (a library) has only units named after it, and no test unit has the name of a unit of the package")]
    spec fn valid(p: &Package) -> bool {
        ident(p.name.as_str()) && version(p.version.as_str()) && units_part(p.name.as_str(), p.units.as_slice(), p.bin_names.len()) && std_part(p.std.as_slice()) && packages_part(p.dep_names.as_slice(), p.dep_paths.as_slice()) && absent(p.dep_names.as_slice(), p.name.as_str()) && bins_part(p.bin_names.as_slice(), p.bin_entries.as_slice(), p.units.len()) && suites_apart(p.tests.as_slice(), p.units.as_slice())
    }

    #[summary("MAJOR.MINOR.PATCH: decimal digits with exactly two dots, neither at an end nor next to the other")]
    spec fn version(s: &str) -> bool {
        exists|i: usize, j: usize| 0 < i && i + 1 < j && j + 1 < s.len() && #[trigger] s.as_bytes()[i] == 46 && #[trigger] s.as_bytes()[j] == 46 && (forall|k: usize| k < s.len() && k != i && k != j ==> digit(#[trigger] s.as_bytes()[k]))
    }
}

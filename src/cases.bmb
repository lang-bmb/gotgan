#[summary("Case files of the format args|stdin|stdout: one case per line, ARGS|STDIN|STDOUT, where ARGS are the driver's arguments separated by spaces or tabs, STDIN the bytes it reads and STDOUT the bytes it must write, both in the escape form of printf %b restricted to \\\\, \\xHH, \\n, \\r and \\t; empty lines and lines that start with # are skipped")]
mod cases {
    #[summary("One case: the number of its line in the file, the driver's arguments, its standard input and the standard output it must give")]
    struct Case { line: usize, args: Vec<String>, input: Vec<u8>, expected: Vec<u8> }

    #[summary("An error at line n of the case file named name")]
    #[effects(alloc)]
    fn at(name: &str, n: usize, why: &str) -> String {
        let mut s: String = String::from(name);
        s.push_str(":");
        std::num::push_u64(&mut s, n as u64);
        s.push_str(": ");
        s.push_str(why);
        s
    }

    #[summary("Where the byte c is first in t[a..b], none when it is not there")]
    #[effects(pure)]
    fn find(t: &[u8], a: usize, b: usize, c: u8) -> (r: Option<usize>)
        requires span(t, a, b),
        ensures match r { None => true, Some(k) => a <= k && k < b && t[k] == c, },
    {
        for k in a..b
            invariant a <= k,
        {
            if t[k] == c {
                return Some(k);
            }
        }
        None
    }

    spec fn grew_at_most(v: &[u8], before: usize, a: usize, b: usize) -> bool {
        before <= v.len() && v.len() <= before + (b - a)
    }

    #[summary("The value of the hexadecimal digit c, none when c is not one")]
    #[effects(pure)]
    fn hex_value(c: u8) -> (r: Option<u8>)
        ensures match r { None => true, Some(v) => v < 16, },
    {
        if 48 <= c && c <= 57 {
            Some(c - 48)
        } else if 97 <= c && c <= 102 {
            Some(c - 87)
        } else if 65 <= c && c <= 70 {
            Some(c - 55)
        } else {
            None
        }
    }

    #[summary("The cases of the case file text t, named name in errors, into out (cleared first), in the order of their lines. An error, with the line, for a line that is not ARGS|STDIN|STDOUT or a field with an escape other than \\\\, \\xHH, \\n, \\r and \\t")]
    #[effects(alloc)]
    fn parse(name: &str, t: &[u8], out: &mut Vec<Case>) -> Result<(), String> {
        *out = Vec::new();
        let mut i: usize = 0;
        let mut n: usize = 0;
        while i < t.len()
            invariant i <= t.len(), n <= i,
            decreases t.len() - i,
        {
            let e: usize = match find(t, i, t.len(), 10) {
                None => t.len(),
                Some(k) => k,
            };
            n = n + 1;
            if e > i && t[i] != 35 {
                let p: usize = match find(t, i, e, 124) {
                    None => { return Err(at(name, n, "no | after the arguments (a case is ARGS|STDIN|STDOUT)")); },
                    Some(k) => k,
                };
                let q: usize = match find(t, p + 1, e, 124) {
                    None => { return Err(at(name, n, "no | after the standard input (a case is ARGS|STDIN|STDOUT)")); },
                    Some(k) => k,
                };
                let mut args: Vec<String> = Vec::new();
                match words(t, i, p, &mut args) {
                    Ok(u) => {},
                    Err(why) => { return Err(at(name, n, why.as_str())); },
                }
                let mut input: Vec<u8> = Vec::new();
                match unescape(t, p + 1, q, &mut input) {
                    Ok(u) => {},
                    Err(why) => { return Err(at(name, n, why.as_str())); },
                }
                let mut expected: Vec<u8> = Vec::new();
                match unescape(t, q + 1, e, &mut expected) {
                    Ok(u) => {},
                    Err(why) => { return Err(at(name, n, why.as_str())); },
                }
                out.push(Case { line: n, args: args, input: input, expected: expected });
            }
            if e >= t.len() {
                return Ok(());
            }
            i = e + 1;
        }
        Ok(())
    }

    spec fn span(t: &[u8], a: usize, b: usize) -> bool {
        a <= b && b <= t.len()
    }

    #[summary("Adds the bytes that the escape form t[a..b] stands for to out: \\\\ a backslash, \\xHH the byte HH, \\n, \\r and \\t those bytes, every other byte itself. Each escape stands for one byte, so out grows by at most b - a. An error, saying where, for any other backslash")]
    #[effects(alloc)]
    fn unescape(t: &[u8], a: usize, b: usize, out: &mut Vec<u8>) -> (r: Result<(), String>)
        requires span(t, a, b),
        ensures grew_at_most(out.as_slice(), old(out).len(), a, b),
    {
        let before: usize = out.len();
        let mut i: usize = a;
        while i < b
            invariant a <= i, i <= b, before <= out.len(), out.len() - before <= i - a,
            decreases b - i,
        {
            let c: u8 = t[i];
            if c != 92 {
                out.push(c);
                i = i + 1;
            } else if i + 1 >= b {
                return Err(String::from("a backslash at the end of a field"));
            } else {
                let e: u8 = t[i + 1];
                if e == 92 {
                    out.push(92);
                    i = i + 2;
                } else if e == 110 {
                    out.push(10);
                    i = i + 2;
                } else if e == 114 {
                    out.push(13);
                    i = i + 2;
                } else if e == 116 {
                    out.push(9);
                    i = i + 2;
                } else if e == 120 && i + 3 < b {
                    match hex_value(t[i + 2]) {
                        None => { return Err(String::from("\\x not followed by two hexadecimal digits")); },
                        Some(h) => match hex_value(t[i + 3]) { None => { return Err(String::from("\\x not followed by two hexadecimal digits")); }, Some(l) => { out.push(h * 16 + l); i = i + 4; }, },
                    }
                } else {
                    return Err(String::from("an escape other than \\\\, \\xHH, \\n, \\r and \\t"));
                }
            }
        }
        Ok(())
    }

    #[summary("The words of t[a..b], separated by runs of spaces and tabs, into out (cleared first); an error when a word is not UTF-8")]
    #[effects(alloc)]
    fn words(t: &[u8], a: usize, b: usize, out: &mut Vec<String>) -> Result<(), String>
        requires span(t, a, b),
    {
        *out = Vec::new();
        let mut i: usize = a;
        while i < b
            invariant a <= i, i <= b,
            decreases b - i,
        {
            if t[i] == 32 || t[i] == 9 {
                i = i + 1;
            } else {
                let from: usize = i;
                let mut w: Vec<u8> = Vec::new();
                w.push(t[i]);
                i = i + 1;
                while i < b && t[i] != 32 && t[i] != 9
                    invariant from < i, i <= b,
                    decreases b - i,
                {
                    w.push(t[i]);
                    i = i + 1;
                }
                match String::from_utf8(w) {
                    Ok(s) => out.push(s),
                    Err(bad) => { return Err(String::from("an argument is not UTF-8")); },
                }
            }
        }
        Ok(())
    }
}

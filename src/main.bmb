#[summary("The command line of gotgan, the package manager of BMB: gotgan [--package DIR] check | verify | test | build | new NAME. The package is the directory DIR (default the current directory) with its package.json. Exit codes: 0 the package passes, 1 it fails, 2 a usage error or a declaration that cannot be read")]
mod main {
    #[summary("Reads the declaration dir/package.json; when it cannot be read or is not valid, says why on standard error and ends with exit code 2")]
    #[effects(alloc, io, nondet)]
    fn load(dir: &str) -> decl::Package {
        let path: String = text::cat2(dir, "/package.json");
        let t: Vec<u8> = match std::fs::read(path.as_str()) {
            Ok(b) => b,
            Err(e) => { eprint_str("gotgan: cannot read "); eprint_str(path.as_str()); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
        };
        match decl::parse(t.as_slice()) {
            Ok(p) => p,
            Err(why) => { eprint_str("gotgan: "); eprint_str(why.as_str()); eprint_str("\n"); std::process::exit(2); },
        }
    }

    #[effects(alloc, io, nondet)]
    fn main() -> () {
        let args: Vec<String> = std::env::args();
        let mut dir: String = String::from(".");
        let mut given: bool = false;
        let mut rest: Vec<String> = Vec::new();
        let mut i: usize = 1;
        while i < args.len()
            invariant 1 <= i,
            decreases args.len() - i,
        {
            if args[i] == "--package" {
                if i + 1 >= args.len() || given {
                    usage();
                }
                dir = args[i + 1].clone();
                given = true;
                i = i + 2;
            } else {
                rest.push(args[i].clone());
                i = i + 1;
            }
        }
        if rest.len() == 0 {
            usage();
        }
        let command: String = rest[0].clone();
        if command == "new" {
            if rest.len() != 2 {
                usage();
            }
            new_package(rest[1].as_str(), dir.as_str(), given);
            return;
        }
        if rest.len() != 1 {
            usage();
        }
        if command != "check" && command != "verify" && command != "test" && command != "build" {
            usage();
        }
        let p: decl::Package = load(dir.as_str());
        if command == "check" {
            if !commands::check(dir.as_str(), &p) {
                std::process::exit(1);
            }
        } else if command == "verify" {
            if !commands::verify(dir.as_str(), &p) {
                std::process::exit(1);
            }
        } else if command == "test" {
            let code: u8 = commands::test(dir.as_str(), &p);
            if code != 0 {
                std::process::exit(code as i32);
            }
        } else if !commands::build(dir.as_str(), &p) {
            std::process::exit(1);
        }
    }

    #[summary("gotgan new NAME: writes the skeleton of the package NAME into the directory NAME, or into DIR when --package DIR is given; ends with exit code 2 when NAME cannot name a unit or is driver, or when a file cannot be written")]
    #[effects(alloc, io)]
    fn new_package(name: &str, dir: &str, given: bool) -> () {
        if !decl::is_unit_name(name) || name == "driver" {
            eprint_str("gotgan: new: `");
            eprint_str(name);
            eprint_str("` cannot name a package (1 to 64 bytes of lower-case ASCII letters, digits and _, the first a letter, not a reserved word, std or driver)\n");
            std::process::exit(2);
        }
        let mut target: String = String::from(name);
        if given {
            target = String::from(dir);
        }
        if !skeleton::write_package(target.as_str(), name) {
            std::process::exit(2);
        }
        let mut r: String = text::row("new");
        text::put_str(&mut r, "package", name);
        text::put_str(&mut r, "path", target.as_str());
        text::put_bool(&mut r, "ok", true);
        text::emit(r.as_str());
    }

    #[summary("Ends gotgan on a bad command line with exit code 2")]
    #[effects(io)]
    fn usage() -> ()
        ensures false,
    {
        eprint_str("usage: gotgan [--package DIR] check | verify | test | build | new NAME\n");
        std::process::exit(2);
    }
}
